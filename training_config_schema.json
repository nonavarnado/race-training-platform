{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Training Plan Configuration Schema",
  "description": "Schema for dual-race endurance training plans with nutrition integration",
  "type": "object",
  "required": ["athlete", "training_plan", "races", "nutrition_plan"],
  "properties": {
    "athlete": {
      "type": "object",
      "required": ["name", "current_fitness"],
      "properties": {
        "name": {"type": "string"},
        "email": {"type": "string", "format": "email"},
        "current_fitness": {
          "type": "object",
          "required": ["run_base_distance", "bike_base_distance"],
          "properties": {
            "run_base_distance": {"type": "number", "minimum": 0},
            "bike_base_distance": {"type": "number", "minimum": 0},
            "weight_lbs": {"type": "number", "minimum": 0},
            "target_weight_lbs": {"type": "number", "minimum": 0},
            "base_run_pace_per_mile": {"type": "string", "pattern": "^[0-9]{1,2}:[0-9]{2}$"},
            "base_bike_speed_mph": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "training_plan": {
      "type": "object",
      "required": ["start_date", "total_weeks"],
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "total_weeks": {"type": "integer", "minimum": 1, "maximum": 52},
        "race_weeks": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "races": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["week", "date", "name", "type", "distance_miles"],
        "properties": {
          "week": {"type": "integer", "minimum": 1},
          "date": {"type": "string", "format": "date"},
          "name": {"type": "string"},
          "type": {"type": "string", "enum": ["run", "bike", "swim", "multi"]},
          "distance_miles": {"type": "number", "minimum": 0},
          "elevation_feet": {"type": "number"},
          "notes": {"type": "string"}
        }
      }
    },
    "nutrition_plan": {
      "type": "object",
      "required": ["phases", "food_lists"],
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "start_date", "end_date"],
            "properties": {
              "name": {"type": "string"},
              "start_date": {"type": "string", "format": "date"},
              "end_date": {"type": "string", "format": "date"},
              "duration_days": {"type": "integer", "minimum": 1},
              "duration_weeks": {"type": "integer", "minimum": 1},
              "food_list": {"type": "string"},
              "food_strategy": {"type": "string"},
              "deficit_calories": {"type": "integer"},
              "calories": {"type": "string"},
              "detail_level": {
                "type": "string",
                "enum": ["general_guidance", "full_meal_plans", "meal_templates", "macro_targets_with_examples", "race_specific"]
              },
              "customization_mode": {"type": "string"},
              "default_deficit": {"type": "integer"}
            }
          }
        },
        "food_lists": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "am_workouts": {
      "type": "object",
      "properties": {
        "spine_exercises": {"type": "object"},
        "strength_foundations": {"type": "object"}
      }
    }
  }
}
